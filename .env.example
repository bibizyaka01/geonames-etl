# Copy this file to .env before configuring the platform.
# This file is a template; service configuration will be added with Compose.

# Start with a small dataset; supported modes will be lite and full.
GEONAMES_MODE=lite

# PostgreSQL DWH settings (access from the host).
DWH_HOST_PORT=5433
DWH_DB=geonames
DWH_USER=geonames
DWH_PASSWORD=

# PostgreSQL Airflow metadata settings.
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=

# Airflow UI port (bound to 127.0.0.1).
AIRFLOW_HOST_PORT=8080
