# Run: powershell -ExecutionPolicy Bypass -File docker/setup-env.ps1
# The script generates missing secrets in .env and preserves existing values.
# DB names, DB users and DB passwords: ASCII letters, digits, _ and - only.

# Start with a small dataset; supported modes will be lite and full.
GEONAMES_MODE=lite
# Total task parallelism; keep 1 normally, use 3 for the scaling demonstration.
GEONAMES_TASK_PARALLELISM=1
# Use solo for the scaling demo; memory savings depend on actual workload.
GEONAMES_CELERY_POOL=prefork

# PostgreSQL DWH settings (access from the host).
DWH_HOST_PORT=5433
DWH_DB=geonames
DWH_USER=geonames
DWH_PASSWORD=

# PostgreSQL Airflow metadata settings.
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=

# Airflow UI port (bound to 127.0.0.1).
AIRFLOW_HOST_PORT=8080

# Initial Airflow UI administrator (created only if missing).
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=

# Shared keys; keep these stable across container recreation.
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
